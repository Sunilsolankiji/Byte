<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Byte</AssemblyName>
    <RootNamespace>Byte.App</RootNamespace>
    <Version>1.1.0</Version>
    <StartupObject>Byte.App.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WPF owns process DPI awareness; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Byte.Core\Byte.Core.csproj" />
  </ItemGroup>
</Project>
